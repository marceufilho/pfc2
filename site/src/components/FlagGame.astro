---
// A game whose rules are a PFC2 program. The moves come from a table generated by running that program.
---

<div class="flag-game not-content">
  <noscript>The game needs JavaScript. The proof it illustrates is on the rest of this page.</noscript>
</div>

<script>
  import { mount } from "../lib/game";
  document.querySelectorAll<HTMLElement>(".flag-game").forEach((element) => mount(element));
</script>

<style is:global>
  .flag-game { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 1.25rem; margin-block: 1.25rem; align-items: start; }
  @media (max-width: 50rem) { .flag-game { grid-template-columns: minmax(0, 1fr); } }
  .flag-game .board { display: grid; gap: 3px; padding: 6px; border: 1px solid var(--pfc-border); border-radius: 0.5rem; background: var(--sl-color-gray-6); }
  .flag-game .board:focus-visible { outline: 3px solid var(--pfc-blue); }
  .flag-game .cell { aspect-ratio: 1; display: grid; place-items: center; border-radius: 0.25rem; background: var(--sl-color-bg); font-size: clamp(1rem, 3.5vw, 1.8rem); line-height: 1; }
  .flag-game .cell.wall { background: var(--sl-color-gray-3); }
  .flag-game .cell.player { color: var(--pfc-blue); }
  .flag-game .cell.flag { color: var(--pfc-verm); }
  .flag-game .cell.won { background: var(--pfc-ok-bg); color: var(--pfc-green); }
  .flag-game button { font: inherit; padding: 0.3rem 0.7rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.3rem; background: var(--sl-color-bg); color: var(--sl-color-text); cursor: pointer; }
  .flag-game button.primary { background: var(--pfc-blue); color: #fff; border-color: var(--pfc-blue); font-weight: 600; }
  .flag-game .controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .flag-game .pad { display: grid; justify-items: center; gap: 0.25rem; margin-block: 0.9rem 0.4rem; width: max-content; }
  .flag-game .pad div { display: flex; gap: 0.25rem; }
  .flag-game .pad button { width: 2.6rem; height: 2.6rem; font-size: 1.1rem; }
  .flag-game .verdict p { margin-block: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 0.3rem; font-size: var(--sl-text-sm); }
  .flag-game .verdict .ok { background: var(--pfc-ok-bg); }
  .flag-game .verdict .bad { background: var(--pfc-bad-bg); }
  .flag-game .verdict .win { background: var(--pfc-warn-bg); }
  .flag-game .rules { grid-column: 1 / -1; border: 1px solid var(--pfc-border); border-radius: 0.5rem; padding: 0.5rem 0.75rem; }
  .flag-game .rules summary { cursor: pointer; font-weight: 600; }
  .flag-game .rules pre { margin: 0.4rem 0 0; font-size: 0.8rem; line-height: 1.45; overflow: auto; max-height: 34rem; }
  .flag-game .rules pre span { display: block; padding-inline: 0.25rem; white-space: pre; }
  .flag-game .rules pre .changed { background: var(--pfc-warn-bg); font-weight: 600; }
  .flag-game .muted { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
</style>
