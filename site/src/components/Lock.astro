---
// A lock whose rule is a PFC2 program. Which combinations open it comes from running that program.
---

<div class="pfc-lock not-content">
  <noscript>The lock needs JavaScript. The proof it illustrates is on the rest of this page.</noscript>
</div>

<script>
  import { mount } from "../lib/lock";
  document.querySelectorAll<HTMLElement>(".pfc-lock").forEach((element) => mount(element));
</script>

<style is:global>
  .pfc-lock { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 1.25rem; margin-block: 1.25rem; align-items: start; }
  @media (max-width: 50rem) { .pfc-lock { grid-template-columns: minmax(0, 1fr); } }
  .pfc-lock .keys { display: flex; gap: 0.5rem; }
  .pfc-lock .keys input { width: 3rem; height: 3.4rem; text-align: center; font: 600 1.6rem var(--sl-font-mono); border: 1px solid var(--sl-color-gray-4); border-radius: 0.4rem; background: var(--sl-color-bg); color: var(--sl-color-text); }
  .pfc-lock .state { margin-block: 0.8rem; padding: 0.5rem 0.75rem; border-radius: 0.3rem; font-size: var(--sl-text-sm); background: var(--sl-color-gray-6); }
  .pfc-lock .state.open { background: var(--pfc-ok-bg); font-weight: 600; }
  .pfc-lock .controls { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pfc-lock button { font: inherit; padding: 0.3rem 0.7rem; border: 1px solid var(--sl-color-gray-4); border-radius: 0.3rem; background: var(--sl-color-bg); color: var(--sl-color-text); cursor: pointer; }
  .pfc-lock button.primary { background: var(--pfc-blue); color: #fff; border-color: var(--pfc-blue); font-weight: 600; }
  .pfc-lock .verdict p { margin: 0; padding: 0.5rem 0.75rem; border-radius: 0.3rem; font-size: var(--sl-text-sm); }
  .pfc-lock .verdict .ok { background: var(--pfc-ok-bg); }
  .pfc-lock .verdict .bad { background: var(--pfc-bad-bg); }
  .pfc-lock .verdict code { overflow-wrap: anywhere; }
  .pfc-lock .rules { grid-column: 1 / -1; border: 1px solid var(--pfc-border); border-radius: 0.5rem; padding: 0.5rem 0.75rem; }
  .pfc-lock .rules summary { cursor: pointer; font-weight: 600; }
  .pfc-lock .rules pre { margin: 0.4rem 0 0; font-size: 0.8rem; line-height: 1.45; overflow: auto; max-height: 34rem; }
</style>
